        <UserObject label="&lt;b&gt;&lt;font face=&quot;Verdana&quot;&gt;?&lt;/font&gt;&lt;/b&gt;" tooltip="Represents the entire ProcessMonitor.Backend project folder which is itself a part of the outer ProcessMonitor solution." id="7qdx8V2ninTG3rhCgIZF-17">
          <mxCell parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fad7ac;strokeColor=#b46504;" vertex="1">
            <mxGeometry height="20" width="20" x="250" y="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;&lt;font face=&quot;Verdana&quot;&gt;?&lt;/font&gt;&lt;/b&gt;" tooltip="Provides the `IHost` application instance that configures background services for the other layers, asynchronous channels and the state singleton. This layer serves as the entry point and host builder acts as an orchestrator that keeps the application running until an interrupt triggers the cancellation token to request a shutdown" id="7qdx8V2ninTG3rhCgIZF-18">
          <mxCell parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fad7ac;strokeColor=#b46504;" vertex="1">
            <mxGeometry height="20" width="20" x="368" y="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;&lt;font face=&quot;Verdana&quot;&gt;?&lt;/font&gt;&lt;/b&gt;" tooltip="This layer provides a class for storing shared runtime state of the application which is used to determing whether the telemtry collection needs to start or not depending on the processId value" id="WrZqJatIKG-vzzKPaSVi-1">
          <mxCell parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fad7ac;strokeColor=#b46504;" vertex="1">
            <mxGeometry height="20" width="20" x="368" y="420" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;&lt;font face=&quot;Verdana&quot;&gt;?&lt;/font&gt;&lt;/b&gt;" tooltip="This layer is responsible for establishing the event tracing system (ETW) session, reading the raw events and filtering them" id="WrZqJatIKG-vzzKPaSVi-2">
          <mxCell parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fad7ac;strokeColor=#b46504;" vertex="1">
            <mxGeometry height="20" width="20" x="368" y="560" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;&lt;font face=&quot;Verdana&quot;&gt;?&lt;/font&gt;&lt;/b&gt;" tooltip="This layer takes the raw kernel events from the `Collection` layer and builds up the metrics snapshots. Those are then pushed into an async channel for further handling" id="WrZqJatIKG-vzzKPaSVi-3">
          <mxCell parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fad7ac;strokeColor=#b46504;" vertex="1">
            <mxGeometry height="20" width="20" x="368" y="730" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;&lt;font face=&quot;Verdana&quot;&gt;?&lt;/font&gt;&lt;/b&gt;" tooltip="The `Commands` layer is composed of classes that parse the commands pipe, route commands to handlers, execute commands, build responses and sends the result back to the command pipe" id="WrZqJatIKG-vzzKPaSVi-4">
          <mxCell parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fad7ac;strokeColor=#b46504;" vertex="1">
            <mxGeometry height="20" width="20" x="368" y="960" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;&lt;font face=&quot;Verdana&quot;&gt;?&lt;/font&gt;&lt;/b&gt;" tooltip="The Publishing layer is composed of two other layers: `Serialization` and `Transport`. It provides a combined and unified logic for determining where the telemetry should go to. This layer is then used to create a corresponding background service" id="WrZqJatIKG-vzzKPaSVi-5">
          <mxCell parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fad7ac;strokeColor=#b46504;" vertex="1">
            <mxGeometry height="20" width="20" x="368" y="1160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;&lt;font face=&quot;Verdana&quot;&gt;?&lt;/font&gt;&lt;/b&gt;" tooltip="The `Transport` layer takes the serialized/deserialized C# types (telemetry metrics and commands) and sends or receives them from the established named pipe IPC connections depending on the data flow stage. This layer is not used directly, but by the `Publishing` and `Commands` layers via compositon" id="WrZqJatIKG-vzzKPaSVi-7">
          <mxCell parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fad7ac;strokeColor=#b46504;" vertex="1">
            <mxGeometry height="20" width="20" x="368" y="1500" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;&lt;font face=&quot;Verdana&quot;&gt;?&lt;/font&gt;&lt;/b&gt;" tooltip="Provides the classes and interfaces that are used internally such as: `RawKernelEvent`, `ProcessMetricsSnapshot` and others " id="WrZqJatIKG-vzzKPaSVi-8">
          <mxCell parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fad7ac;strokeColor=#b46504;" vertex="1">
            <mxGeometry height="20" width="20" x="368" y="1800" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;&lt;font face=&quot;Verdana&quot;&gt;?&lt;/font&gt;&lt;/b&gt;" tooltip="Contains configuration files for launching the hosted application" id="WrZqJatIKG-vzzKPaSVi-9">
          <mxCell parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fad7ac;strokeColor=#b46504;" vertex="1">
