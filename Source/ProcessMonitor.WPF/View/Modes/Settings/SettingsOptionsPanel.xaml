<UserControl x:Class="ProcessMonitor.WPF.View.Modes.Settings.SettingsOptionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProcessMonitor.WPF.View.Modes.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer
        Name="SettingsOptionsPanelControl"
        VerticalScrollBarVisibility="Auto" 
        HorizontalScrollBarVisibility="Auto">
        <StackPanel 
            Width="800"
            Height="450"
            Background="LightPink">
            <local:BackendFilePathOption HorizontalAlignment="Center"/>
            <local:TargetPIDOption/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
