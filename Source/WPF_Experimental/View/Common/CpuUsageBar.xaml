<UserControl x:Class="WPF_Experimental.View.Common.CpuUsageBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_Experimental.View.Common"
             mc:Ignorable="d" 
             x:Name="Root"
             d:DesignHeight="100" d:DesignWidth="100">
    <Grid Width="100" Height="100">
        <Ellipse Stroke="#EAEAEA" StrokeThickness="8" Margin="5"/>

        <Path Stroke="#007ACC" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="5">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="50,5">
                        <ArcSegment x:Name="ProgressArc" 
                                    Size="45,45" 
                                    SweepDirection="Clockwise" />
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <TextBlock Text="{Binding ElementName=Root, Path=Value, StringFormat={}{0:0}%}" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   FontWeight="Bold" 
                   FontSize="16" 
                   Foreground="#333333"/>
    </Grid>
</UserControl>
