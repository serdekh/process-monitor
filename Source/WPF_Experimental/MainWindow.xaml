<Window x:Class="WPF_Experimental.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Experimental"
        xmlns:Modes="clr-namespace:WPF_Experimental.View.Modes"
        xmlns:State="clr-namespace:WPF_Experimental.Client.State"
        mc:Ignorable="d"
        Title="Process Monitor" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <Modes:StartupModeWindow/>
        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Source={x:Static State:ApplicationState.Instance}, Path=CurrentModeAsString}" HorizontalAlignment="Center"/>
            <Rectangle Grid.Column="1" Fill="SeaGreen"/>
        </Grid>
    </Grid>
</Window>
