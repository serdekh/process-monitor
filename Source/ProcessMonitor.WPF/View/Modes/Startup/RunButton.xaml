<UserControl x:Class="ProcessMonitor.WPF.View.Modes.Startup.RunButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProcessMonitor.WPF.View.Modes.Startup"
             mc:Ignorable="d" 
             d:DesignHeight="90" d:DesignWidth="160">
    <Button
        Name="RunButtonControl"
        Height="90"
        Width="160"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Content="Run"
        FontSize="40"
        Click="RunButtonControl_Click"/>
</UserControl>
