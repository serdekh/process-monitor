<UserControl x:Class="ProcessMonitor.WPF.View.Common.LogsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProcessMonitor.WPF.View.Common"
             xmlns:Services="clr-namespace:ProcessMonitor.WPF.Services"
             mc:Ignorable="d" 
             d:DesignHeight="20">
    <ScrollViewer 
        Name="LogsPanelControl"
        VerticalScrollBarVisibility="Auto" 
        HorizontalScrollBarVisibility="Auto">
        <ListBox ItemsSource="{Binding Source={x:Static Services:LoggingService.Instance}, Path=Logs}"
            Background="#1E1E1E" 
            Foreground="White"
            FontFamily="Consolas">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,3"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#D4D4D4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" 
                        FontFamily="Consolas" 
                        FontSize="14"
                        TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </ScrollViewer>
</UserControl>
