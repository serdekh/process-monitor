<UserControl x:Class="ProcessMonitor.WPF.View.Modes.Running.RunningMode"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProcessMonitor.WPF.View.Modes.Running"
             xmlns:ModeComponents="clr-namespace:ProcessMonitor.WPF.View.Modes.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Name="RunningModeControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <ModeComponents:Header Grid.Row="0"/>
        <GridSplitter Grid.Row="2"/>
        <ModeComponents:Footer Grid.Row="3"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <local:ThreadsList Grid.Column="1"/>
            
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <local:CPUUsageBar Grid.Row="0"/>
                <local:SyscallsCountLabel Grid.Row="1"/>
                <local:ContextSwitchesCountLabel Grid.Row="2"/>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
